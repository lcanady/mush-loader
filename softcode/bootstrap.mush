# mush-loader bootstrap object
# Run this file once to create the loader object on your game.
# After this, run commands.mush to install the +mload command suite.
#
# Requires: Wizard-level account, execscript enabled for owner.

@create MushLoader <sys>
@set MushLoader <sys>=inherit safe
@fo me=&d.mload me=search(name=MushLoader <sys>)

# Version marker
&MLOAD_VERSION [v(d.mload)]=0.1.0

# Persistent state attributes
&MLOAD_LOG [v(d.mload)]=
&MLOAD_PENDING [v(d.mload)]=
&MLOAD_QUEUE [v(d.mload)]=

# Lock to any wizard.  hasflag(%#,wizard) checks the ENACTOR, not the object.
# /use gates $cmd execution (and USE, PAY, ^listen triggers).
# Default lock gates @force and object control.
@lock [v(d.mload)]=hasflag(%#,wizard)
@lock/use [v(d.mload)]=hasflag(%#,wizard)

# Grant the execscript power at ARCHITECT level so the object can call
# execscript() with arguments.  This is required for in-game +mload commands.
# See: wizhelp POWER EXECSCRIPT
@power [v(d.mload)]=@a execscript

@fo me=@pemit me=MushLoader <sys> installed at [v(d.mload)].
