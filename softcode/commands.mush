# mush-loader in-game command suite
# Requires bootstrap.mush to have been run first.
# Requires execscript enabled and mush-loader installed on the host server.
#
# All commands are wizard-only via hasflag(%#,wizard) guards and
# the use lock on MushLoader <sys>.

@fo me=&d.mload me=search(name=MushLoader <sys>)

# ---------------------------------------------------------------------------
# Internal UDFs
# ---------------------------------------------------------------------------

# FN_WIZARD_CHECK: returns 1 if enactor is wizard, 0 otherwise
# Used by all trigger targets to verify caller since @trigger bypasses use lock.
&FN_WIZARD_CHECK [v(d.mload)]=
  [hasflag(%0, wizard)]

# FN_SAFE_PATH: sanitize a file path argument before passing to execscript.
# Allows only: a-z A-Z 0-9 / . - _ @
# Blocks: shell metacharacters AND any path containing .. (traversal)
# Returns #-1 INVALID PATH if unsafe.
# %0 = raw path argument
&FN_SAFE_PATH [v(d.mload)]=
  [if(
    and(
      regmatchi(%0, ^[a-zA-Z0-9/._@][a-zA-Z0-9/._@-]*$),
      not(regmatchi(%0, \.\.))
    ),
    %0,
    #-1 INVALID PATH
  )]

# FN_SAFE_PKG: sanitize a registry package name (no / or .. ever needed).
# Allows only: a-z A-Z 0-9 @ . - _
# Returns #-1 INVALID PACKAGE NAME if unsafe.
# %0 = raw package argument (e.g. "bboard@1.0.0")
&FN_SAFE_PKG [v(d.mload)]=
  [if(
    regmatchi(%0, ^[a-zA-Z0-9@._-]+$),
    %0,
    #-1 INVALID PACKAGE NAME
  )]

# FN_LOG: append a timestamped entry to MLOAD_LOG
# Log entries are escape()'d before storage to prevent re-evaluation on display.
# %0 = message
&FN_LOG [v(d.mload)]=
  [setq(0, strcat(convsecs(secs()), %b, escape(%0)))]
  [set(v(d.mload), MLOAD_LOG:
    [if(get(v(d.mload)/MLOAD_LOG),
      trim(strcat(get(v(d.mload)/MLOAD_LOG), |, %q0)),
      %q0
    )]
  )]

# FN_EXEC: run mush-loader CLI via execscript.
# Calls the 'mload' wrapper script that must exist in your game's execscripthome.
# %0 = subcommand — must be one of the allowlisted values below (hardcoded by callers).
# %1 = pre-validated safe argument (path or pkg name) — pass empty to omit.
# Defense-in-depth: even though all callers hardcode %0, the allowlist ensures
# no future caller can accidentally pass user input as the subcommand.
# See: scripts/mload and docs/game-setup.md Step 5
&FN_EXEC [v(d.mload)]=
  [if(
    not(member(load vet install registry status, %0)),
    #-1 INVALID SUBCOMMAND,
    if(%1,
      execscript(mload, %0, %1),
      execscript(mload, %0)
    )
  )]

# ---------------------------------------------------------------------------
# +mload — base command (no switch): show usage
# NOTE: This MUST be the LAST $+mload pattern defined so the wildcard does not
# shadow the switch-specific patterns above it.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# +mload/vet <file> — vet first, queue for approval
# DEFINED FIRST so it is scanned before the $+mload * wildcard.
# ---------------------------------------------------------------------------
&CMD_MLOAD_VET [v(d.mload)]=$+mload/vet *:
  @switch/first 1=
    [not(hasflag(%#,wizard))], {
      @pemit %#=Permission denied.
    },
    [not(%0)], {
      @pemit %#=Usage: +mload/vet <file.mush>
    },
    [get(v(d.mload)/MLOAD_PENDING)], {
      @pemit %#=A load is already pending approval. Use +mload/approve or +mload/reject first.
    },
    {
      @pemit %#=%ch%cyVetting%cn [escape(%0)]... (this may take a moment);
      @trigger [v(d.mload)]/TR_EXEC_VET=%0,%#
    }

&TR_EXEC_VET [v(d.mload)]=
  @switch/first 1=
    [not(u(v(d.mload)/FN_WIZARD_CHECK, %#))], {
      @pemit %1=Permission denied.
    },
    [not(get(v(d.mload)/MLOAD_INSTALL_PATH))], {
      @pemit %1=Error: MLOAD_INSTALL_PATH not set.
    },
    {
      [setq(9, u(v(d.mload)/FN_SAFE_PATH, %0))]
      [if(
        isdbref(%q9),
        @pemit %1=Invalid path: [escape(%0)]. Only alphanumerics and / . - _ @ are allowed.,
        [setq(0, u(v(d.mload)/FN_EXEC, vet, %q9))]
        @set [v(d.mload)]=MLOAD_PENDING:1;
        @set [v(d.mload)]=MLOAD_QUEUE:%q9;
        @pemit %1=Vet result for [escape(%q9)]:%r[escape(%q0)]%r%rUse +mload/approve to install or +mload/reject to cancel.;
        @trigger [v(d.mload)]/TR_LOG=Vetted [escape(%q9)] by [name(%1)]
      )]
    }

# ---------------------------------------------------------------------------
# +mload/approve — approve and run a pending vetted load
# ---------------------------------------------------------------------------
&CMD_MLOAD_APPROVE [v(d.mload)]=$+mload/approve:
  @switch/first 1=
    [not(hasflag(%#,wizard))], {
      @pemit %#=Permission denied.
    },
    [not(get(v(d.mload)/MLOAD_QUEUE))], {
      @pemit %#=Nothing pending. Use +mload/vet <file> first.
    },
    {
      @pemit %#=%ch%cyInstalling%cn [escape(get(v(d.mload)/MLOAD_QUEUE))]...;
      @trigger [v(d.mload)]/TR_EXEC_LOAD=[get(v(d.mload)/MLOAD_QUEUE)],%#;
      &MLOAD_PENDING [v(d.mload)]=;
      &MLOAD_QUEUE [v(d.mload)]=
    }

# ---------------------------------------------------------------------------
# +mload/reject — reject and clear a pending vetted load
# ---------------------------------------------------------------------------
&CMD_MLOAD_REJECT [v(d.mload)]=$+mload/reject:
  @switch/first 1=
    [not(hasflag(%#,wizard))], {
      @pemit %#=Permission denied.
    },
    [not(get(v(d.mload)/MLOAD_QUEUE))], {
      @pemit %#=Nothing pending.
    },
    {
      @pemit %#=Load of [escape(get(v(d.mload)/MLOAD_QUEUE))] rejected and cleared.;
      @trigger [v(d.mload)]/TR_LOG=Rejected [escape(get(v(d.mload)/MLOAD_QUEUE))] by [name(%#)];
      &MLOAD_PENDING [v(d.mload)]=;
      &MLOAD_QUEUE [v(d.mload)]=
    }

# ---------------------------------------------------------------------------
# +mload/registry — list available registry packages
# ---------------------------------------------------------------------------
&CMD_MLOAD_REGISTRY [v(d.mload)]=$+mload/registry:
  @switch/first 1=
    [not(hasflag(%#,wizard))], {
      @pemit %#=Permission denied.
    },
    [not(get(v(d.mload)/MLOAD_INSTALL_PATH))], {
      @pemit %#=Error: MLOAD_INSTALL_PATH not set.
    },
    {
      @pemit %#=%ch%cyRegistry packages:%cn;
      @pemit %#=[escape(u(v(d.mload)/FN_EXEC, registry, ))]
    }

# ---------------------------------------------------------------------------
# +mload/install <pkg> — fetch from registry and install
# ---------------------------------------------------------------------------
&CMD_MLOAD_INSTALL [v(d.mload)]=$+mload/install *:
  @switch/first 1=
    [not(hasflag(%#,wizard))], {
      @pemit %#=Permission denied.
    },
    [not(%0)], {
      @pemit %#=Usage: +mload/install <pkg[@version]>
    },
    [not(get(v(d.mload)/MLOAD_INSTALL_PATH))], {
      @pemit %#=Error: MLOAD_INSTALL_PATH not set.
    },
    {
      @pemit %#=%ch%cyInstalling%cn [escape(%0)] from registry...;
      @trigger [v(d.mload)]/TR_EXEC_INSTALL=%0,%#
    }

&TR_EXEC_INSTALL [v(d.mload)]=
  @switch/first 1=
    [not(u(v(d.mload)/FN_WIZARD_CHECK, %#))], {
      @pemit %1=Permission denied.
    },
    {
      [setq(9, u(v(d.mload)/FN_SAFE_PKG, %0))]
      [if(
        isdbref(%q9),
        @pemit %1=Invalid package name: [escape(%0)]. Only alphanumerics and @ . - _ are allowed.,
        [setq(0, u(v(d.mload)/FN_EXEC, install, %q9))]
        @pemit %1=[escape(%q0)];
        @trigger [v(d.mload)]/TR_LOG=Registry install [escape(%q9)] by [name(%1)]
      )]
    }

# ---------------------------------------------------------------------------
# +mload/status — show last operation status
# ---------------------------------------------------------------------------
&CMD_MLOAD_STATUS [v(d.mload)]=$+mload/status:
  @switch/first 1=
    [not(hasflag(%#,wizard))], {
      @pemit %#=Permission denied.
    },
    [not(get(v(d.mload)/MLOAD_LOG))], {
      @pemit %#=No operations logged yet.
    },
    {
      @pemit %#=Last operation: [last(iter(get(v(d.mload)/MLOAD_LOG), %i0, |))]
    }

# ---------------------------------------------------------------------------
# +mload/log — show full load history
# ---------------------------------------------------------------------------
&CMD_MLOAD_LOG [v(d.mload)]=$+mload/log:
  @switch/first 1=
    [not(hasflag(%#,wizard))], {
      @pemit %#=Permission denied.
    },
    [not(get(v(d.mload)/MLOAD_LOG))], {
      @pemit %#=No operations logged yet.
    },
    {
      @pemit %#=%ch%cymush-loader history:%cn;
      @pemit %#=[iter(get(v(d.mload)/MLOAD_LOG), %i0, |, %r)]
    }

# ---------------------------------------------------------------------------
# +mload <file> — load without vetting
# DEFINED LAST — wildcard pattern; switch patterns above take priority.
# ---------------------------------------------------------------------------
&CMD_MLOAD_FILE [v(d.mload)]=$+mload *:
  @switch/first 1=
    [not(hasflag(%#,wizard))], {
      @pemit %#=Permission denied.
    },
    [not(%0)], {
      @pemit %#=Usage: +mload <file.mush>
    },
    {
      @pemit %#=%ch%cyLoading%cn [escape(%0)]...;
      &MLOAD_PENDING [v(d.mload)]=;
      @trigger [v(d.mload)]/TR_EXEC_LOAD=%0,%#
    }

&TR_EXEC_LOAD [v(d.mload)]=
  @switch/first 1=
    [not(u(v(d.mload)/FN_WIZARD_CHECK, %#))], {
      @pemit %1=Permission denied.
    },
    [not(get(v(d.mload)/MLOAD_INSTALL_PATH))], {
      @pemit %1=Error: MLOAD_INSTALL_PATH not set on [v(d.mload)]. Run: &MLOAD_INSTALL_PATH [v(d.mload)]=</path/to/mush-loader>
    },
    {
      [setq(9, u(v(d.mload)/FN_SAFE_PATH, %0))]
      [if(
        isdbref(%q9),
        @pemit %1=Invalid path: [escape(%0)]. Only alphanumerics and / . - _ @ are allowed.,
        @pemit %1=[escape(u(v(d.mload)/FN_EXEC, load, %q9))];
        @trigger [v(d.mload)]/TR_LOG=Loaded [escape(%q9)] by [name(%1)]
      )]
    }

# ---------------------------------------------------------------------------
# +mload (no args) — usage display (pulls from HELP_MLOAD)
# u() evaluates the attribute so %r/%ch/%cn and [get(...)] expand correctly.
# ---------------------------------------------------------------------------
&CMD_MLOAD [v(d.mload)]=$+mload:
  @switch/first 1=
    [not(hasflag(%#,wizard))], {
      @pemit %#=Permission denied.
    },
    {
      @pemit %#=[u(v(d.mload)/HELP_MLOAD)]
    }

# ---------------------------------------------------------------------------
# +mload/help — no-arg form: show overview
# ---------------------------------------------------------------------------
&CMD_MLOAD_HELP_BARE [v(d.mload)]=$+mload/help:
  @switch/first 1=
    [not(hasflag(%#,wizard))], {
      @pemit %#=Permission denied.
    },
    {
      @pemit %#=[u(v(d.mload)/HELP_MLOAD)]
    }

# ---------------------------------------------------------------------------
# +mload/help <topic> — per-switch help dispatch
# ---------------------------------------------------------------------------
&CMD_MLOAD_HELP [v(d.mload)]=$+mload/help *:
  @switch/first 1=
    [not(hasflag(%#,wizard))], {
      @pemit %#=Permission denied.
    },
    [not(%0)], {
      @pemit %#=[u(v(d.mload)/HELP_MLOAD)]
    },
    {
      @pemit %#=[switch(%0,
        vet,      [u(v(d.mload)/HELP_MLOAD_VET)],
        approve,  [u(v(d.mload)/HELP_MLOAD_APPROVE)],
        reject,   [u(v(d.mload)/HELP_MLOAD_REJECT)],
        registry, [u(v(d.mload)/HELP_MLOAD_REGISTRY)],
        install,  [u(v(d.mload)/HELP_MLOAD_INSTALL)],
        status,   [u(v(d.mload)/HELP_MLOAD_STATUS)],
        log,      [u(v(d.mload)/HELP_MLOAD_LOG)],
        No help found for '+mload/[escape(%0)]'. Try +mload/help for a list.
      )]
    }

# ---------------------------------------------------------------------------
# TR_LOG — internal trigger: log an operation
# %0 = message (should already be escape()'d by caller)
# ---------------------------------------------------------------------------
&TR_LOG [v(d.mload)]=
  @trigger [v(d.mload)]/FN_LOG=%0

# ---------------------------------------------------------------------------
# In-game help text  (wizhelp +mload, wizhelp +mload/<switch>)
# ---------------------------------------------------------------------------

&HELP_MLOAD [v(d.mload)]=
  %ch%cy+MLOAD%cn                                              Wizard only%r
  %r
  Manages loading of softcode onto this game via the mush-loader system.%r
  All commands require the WIZARD flag.  Files are validated before loading;%r
  use +mload/vet to also run AI analysis before anything is installed.%r
  %r
  %chSwitches:%cn%r
    %ch/vet <file>%cn        Vet file with AI, queue result for approval.%r
    %ch/approve%cn           Install the pending vetted file.%r
    %ch/reject%cn            Discard the pending vetted file.%r
    %ch/registry%cn          List packages available in the mush-loader registry.%r
    %ch/install <pkg>%cn     Download and install a registry package.%r
    %ch/status%cn            Show the most recent logged operation.%r
    %ch/log%cn               Show full load history.%r
    %ch/help [<topic>]%cn    Show this help, or help for a specific switch.%r
  %r
  %chExamples:%cn%r
    +mload /opt/mush-loader/packages/bboard.mush%r
    +mload/vet /opt/mush-loader/packages/bboard.mush%r
    +mload/approve%r
    +mload/install bboard@1.0.0%r
  %r
  See also: +mload/vet, +mload/registry, wizhelp POWER EXECSCRIPT

&HELP_MLOAD_VET [v(d.mload)]=
  %ch%cy+MLOAD/VET <file>%cn                                   Wizard only%r
  %r
  Submits <file> to AI vetting before installation.  The file is read,%r
  statically validated, then passed to the configured AI provider for%r
  security analysis.  The result is displayed and the load is queued.%r
  %r
  Only one load may be pending at a time.  Resolve it with +mload/approve%r
  or +mload/reject before vetting another file.%r
  %r
  <file> must be an absolute path to a .mush file on the game server.%r
  Allowed characters: a-z A-Z 0-9 / . - _ @  (no shell metacharacters).%r
  %r
  %chExamples:%cn%r
    +mload/vet /opt/mush-loader/packages/bboard.mush%r
    +mload/vet /home/mush/custom/mycommands.mush%r
  %r
  See also: +mload/approve, +mload/reject, +mload

&HELP_MLOAD_APPROVE [v(d.mload)]=
  %ch%cy+MLOAD/APPROVE%cn                                      Wizard only%r
  %r
  Installs the file currently queued by +mload/vet.  The file was already%r
  vetted; this step executes the actual load.%r
  %r
  If no load is pending, you will be told so.%r
  %r
  See also: +mload/vet, +mload/reject

&HELP_MLOAD_REJECT [v(d.mload)]=
  %ch%cy+MLOAD/REJECT%cn                                       Wizard only%r
  %r
  Clears the file currently queued by +mload/vet without installing it.%r
  Use this if the vet result shows issues you do not want to install.%r
  %r
  See also: +mload/vet, +mload/approve

&HELP_MLOAD_REGISTRY [v(d.mload)]=
  %ch%cy+MLOAD/REGISTRY%cn                                     Wizard only%r
  %r
  Lists packages available in the mush-loader community registry.%r
  Each package shows its name, version, vet status, description, and tags.%r
  %r
  To install a listed package:%r
    +mload/install <name>@<version>%r
  %r
  Registry URL is set in REGISTRY_URL in your loader.conf.%r
  Default: https://raw.githubusercontent.com/lcanady/mush-registry/main/index.json%r
  %r
  See also: +mload/install

&HELP_MLOAD_INSTALL [v(d.mload)]=
  %ch%cy+MLOAD/INSTALL <pkg[@version]>%cn                      Wizard only%r
  %r
  Downloads <pkg> from the community registry, verifies its SHA-256%r
  integrity hash, and installs it.  If a version is omitted, the latest%r
  available version is used.%r
  %r
  <pkg> may only contain: a-z A-Z 0-9 @ . - _  (no path separators).%r
  %r
  %chExamples:%cn%r
    +mload/install bboard%r
    +mload/install bboard@1.0.0%r
  %r
  See also: +mload/registry

&HELP_MLOAD_STATUS [v(d.mload)]=
  %ch%cy+MLOAD/STATUS%cn                                       Wizard only%r
  %r
  Displays the most recent entry in the load history log.%r
  %r
  See also: +mload/log

&HELP_MLOAD_LOG [v(d.mload)]=
  %ch%cy+MLOAD/LOG%cn                                          Wizard only%r
  %r
  Displays the full load history: every load, vet, approval, rejection,%r
  and registry install, with timestamps.%r
  %r
  See also: +mload/status

@fo me=@pemit me=+mload command suite installed on [v(d.mload)].
@fo me=@pemit me=Next step: &MLOAD_INSTALL_PATH [v(d.mload)]=</absolute/path/to/mush-loader>
