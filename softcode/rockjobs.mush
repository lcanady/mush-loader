# Rockpath's Jobs System v2.1.3 — RhostMUSH fixed + SR4 hooks
#
# A full staff job-ticket system with player-facing +request commands.
#
# This file combines three layers in install order:
#   1. Core system  (RockJobs.fixed.mush — B1-B16 + I13 fixes over upstream 2.1.3)
#   2. Help system  (help.mush — per-topic +jobs/help dispatch + expanded player help)
#   3. Security     (security.mush — SAFE flags, INHERIT removal, injection guards)
#
# Staff commands:
#   +job/create <Cat>/<Topic>=<Body>  Create a job ticket
#   +jobs                             List all open jobs by tier
#   +job <#>                          View a single job
#   +job/complete <#>=<comment>       Close as complete; fires HOOK_ON_COMPLETE
#   +job/approve <#>=<comment>        Close as approved; fires HOOK_ON_APPROVE
#   +job/deny <#>=<comment>           Close as denied; fires HOOK_ON_DENY
#   +job/comment <#>=<comment>        Append comment; fires HOOK_ON_COMMENT
#   +job/claim <#>                    Claim as handler
#   +job/assign <#>=<staff>           Assign to another staff member
#   +job/status <#>=<value>           Set progress (new/underway/hold/done/25/50/75/100)
#   +job/urgency <#>=<1-4|color>      Set urgency level
#   +job/rename <#>=<title>           Rename job
#   +job/cat <#>=<category>           Move to different category
#   +job/tier <#>=[!]<tier>           Set/remove tier access
#   +job/delete <#>                   Delete without ruling
#   +jobs/mine                        List jobs assigned to you
#   +jobs/cat <category>              Filter job list by category
#   +jobs/reorder                     Compress job numbering
#   +jobs/help [<topic>]              In-game help
#
# Player commands:
#   +request/create <Cat>/<Topic>=<Body>  Submit a request
#   +requests                             List your own requests
#   +request <#>                          View one of your requests
#   +request/comment <#>=<comment>        Comment on your request
#   +request/cancel <#>                   Cancel your request
#   +request/help                         Player help
#
# Outbound hooks (on Rockpath's Jobs System — empty stubs, set at SR4 install time):
#   HOOK_ON_COMPLETE  %0=category  %1=requester-dbref  %2=staff-comment
#   HOOK_ON_APPROVE   %0=category  %1=requester-dbref  %2=staff-comment
#   HOOK_ON_DENY      %0=category  %1=requester-dbref  %2=staff-comment
#   HOOK_ON_COMMENT   %0=job-dbref %1=category %2=commenter-dbref %3=comment-text
#
# Inbound API — call these from SR4 systems (no staff check, trusted internal):
#   u(<rj-db>/fn`create-job, category, topic, body, requester_dbref)
#     %3=requester override; omit to use %# as requester
#   u(<rj-db>/fn`complete-job, job_dbref, comment)
#   u(<rj-db>/fn`approve-job, job_dbref, comment)
#   u(<rj-db>/fn`deny-job, job_dbref, comment)
#   u(<rj-db>/fn`get-job, job_number)   -> job dbref or empty
#   u(<rj-db>/fn`cancel-request, job_dbref)
#
# At SR4 install time, store the Job Database dbref on each SR4 sys object:
#   &_RJ_DB SR4 Karma <sys>=[num(Rockpath's Job Database)]
#
# SR4 categories added: KARMA, RUN  (CG and PLOT were already present)
#
# Changes from upstream v2.1.3:
#   B1   FN`URGENT: removed unmatched trailing )]
#   B2   CMD`ASSIGN: register fix + mailsend() for RhostMUSH
#   B3   CMD`TIER: %q8/%q9 positional registers
#   B4   Removed @toggle PENN_MAIL (not valid in RhostMUSH)
#   B5   CMD`MYJOBS: @assert -> @break
#   B6   CMD`STATUS: added missing command handler
#   B7   FN`PROMPT: case-insensitive, req/default cases
#   B8   FN`SHOWJOB/CREATE-JOB/mail fns: desc not describe
#   B9   Version string corrected to 2.1.3
#   B10  CMD`REQ-COMMENT: proper validation order
#   B16  All job lists: removed revwords() — ascending order
#   I13  CMD`FILTERCAT: +jobs/cat <Category> filter command
#   SR4  HOOK_ON_COMPLETE/APPROVE/DENY/COMMENT outbound hooks
#   SR4  FN`CREATE-JOB: %3 requester override
#   SR4  LIST`CATEGORIES: added KARMA, RUN
#   SEC  SAFE flags, @lock/use on Job Database, INHERIT removed from Jobs System
#   SEC  isnum() guards on CMD`VIEW-REQ + CMD`CANCEL
#   SEC  Bracket-injection guards on CMD`REQ-ADD + CMD`REQ-COMMENT
#   SEC  Bracket-injection guards on CMD`RENAME + CMD`COMMENT (stored injection M-RJ-01/02)
#
# Requirements:
#   RhostMUSH with mailsend() available
#   Wizard-level installer account
#   Paste as Wizard or use: mush-loader load rockjobs.mush
#
# Tests: rockjobs/tests/rockjobs.test.ts

#!pre-install
think Pre-install: checking wizard access for RockJobs install...
#!end-pre-install

# ---------------------------------------------------------------------------
# Core system — Rockpath's Jobs System v2.1.3 (fixed)
# ---------------------------------------------------------------------------

@pemit me=[repeat(=,78)]%r[center(Constructing Rockpath's Job System v 2.1.3,78)]%r[repeat(-,78)]%rPlease wait...%r

@pemit me=Setting the SIDEFX flag on yourself to build this.
@set me=sidefx

@eval [setq(0, [create(Rockpath's Jobs System)])][setq(1, [create(Rockpath's Job Database)])][set(%q0, database:%q1)][set(%q1, system:%q0)]

@set me=quiet

@lock Rockpath's Jobs System=me

@@ I13: added +jobs/cat to help text; fixed typo "chnanged" -> "changed"
@Desc Rockpath's Jobs System=[printf($^78:[ansi(hb, -=)]:s, < [ansi(hw, Rockpath's Jobs System Help)] >)]%r[u([v(database)]/fn`formathelp, {+job/create Category/Topic=Contents - Create a new job. Categories are: [elist([get([v(database)]/list`categories)],,,,,[ansi(y, %0)])]%r+jobs - Look at all the jobs%r+job <#> - Look at the details of a job.%r+jobs/reorder - Reorganize the jobs. Known as 'compress'%r+job/delete <#> - Delete a job. There will be some records created%r+job/approve #=<comment> - Approve a job. If you don't want to add a comment, then leave it blank. But keep the = sign.%r+job/deny <#>=<comment> - Deny a job. If you don't want to add a comment, then leave it blank. But keep the = sign.%r+job/complete <#>=<comment> - Complete a job. If you don't want to add a comment, then leave it blank. But keep the = sign.%r+job/status <#>=<new|underway|hold|done|25|50|75|100> - Set the progress of the job%r+job/comment <#>=<comment> - Comment on a job. This is simply appended to the job description.%r+job/cat <#>=<Category> - Move the job from one Category to another. Tier is not changed automatically.%r+job/urgency <#>=<1-4|red|yellow|green> - Set the urgency of a job.%r+job/rename <#>=<New Name> - Rename a job. It does /not/ change the Number of a job.%r+job/claim <#> - Claim a job for yourself.%r+job/assign <#>=<Staff Member> - Assign a job to another person. This command will alert other Staff.%r+jobs/mine - List jobs assigned to you.%r+jobs/cat <Category> - List jobs filtered by category.%r+job/tier <#>=[!]<Tier> - Set a job to Tier-level access. Placing a ! in front of the tier removes its access (be sure to always leave at least one level of access.)})]%r[printf($^78:[ansi(hb, -=)]:s, < [ansi(hw, End Help)] >)]

&CMD`ADD Rockpath's Jobs System=$+job/create */*=*:@break [u([v(database)]/bool`is-staff)]={@break [t([match([get([v(database)]/list`categories)], %0)])]={@eval [u([v(database)]/fn`create-job, %0, %1, %2)];@pemit %#=[u([v(database)]/fn`prompt, req)] You have created a new Job under the [ansi(y, [ucstr(%0)])] category.}; @pemit %#=[u([v(database)]/fn`prompt, jobs)] Invalid Category. Please choose from [elist([get([v(database)]/list`categories)], or)].};@pemit %#=[error()]

@@ B16: removed revwords() — jobs display in ascending (creation) order
&CMD`VIEW-ALL Rockpath's Jobs System=$+jobs:@break [u([v(database)]/bool`is-staff)]={@pemit %#={[printf($^78:[ansi(hb, -=)]:s, < [ansi(hw, [mudname() Jobs])] >)]%r[ansi(c, [printf($3^s $6-s $12-s $25-s $6-s $12-s $8^s, #, Type, Requester, Job Title, Start, Handler, Status)])]%r[repeat(-, 78)]};@skip/ifelse [t([lcon([v(database)]/object)])]={@eval [iter([lcon([v(database)]/object)], [if([lor([iter([get(%i0/tier)], [u([v(database)]/tier`%i0, %#)])])], [pemit(%#, [ansi([switch([get(##/urgency)], 1, hg, 2, hy, 3, hr, n)], [printf($3^s $6-s $12-s $25-s $6-s $12-s $8s, [after([name(##)], %b)], [get(##/category)], [name([get(##/requester)])], [get(##/JName)], [if([hasattr(##/started)], [timefmt($02M/$02D, [get(##/started)])], --------)], [if([hasattr(##, handler)], [name([get(##/handler)])], -----)], [get(##/status)])])])])])])}};@pemit %#={[printf($^78:[ansi(hb, -=)]:s, < [ansi(hw, End Jobs)] >)]}};@pemit %#=[error()]

&CMD`VIEW-JOB Rockpath's Jobs System=$+job *:@break [u([v(database)]/bool`is-staff)]={@break [t([setr(j, [u([v(database)]/fn`get-job, %0)])])]={@skip/ifelse [t([lor([iter([get(%qj/tier)], [u([v(database)]/tier`##, %#)])])])]={@eval [u([v(database)]/fn`showjob, %qj)]}, @pemit %#=[u([v(database)]/fn`prompt, jobs)] You don't have permission to look at that job.}; @pemit %#=[u([v(database)]/fn`prompt, jobs)] You must specify a valid number.};@pemit %#={[printf($^78:[ansi(hb, -=)]:s, < [ansi(hw, End Jobs)] >)]}};@pemit %#=[error()]

@@ B16: removed revwords() from reorder
&CMD`REORDER Rockpath's Jobs System=$+jobs/reorder:@skip/ifelse [strmatch(%#, [owner(me)])]={@cemit staff={[u([v(database)]/fn`prompt, jobs)] The jobs were reordered.};@eval [set([v(database)], count:1)][iter([lcon([v(database)]/object)], [name(##, Job [get([v(database)]/count)])][set([v(database)], count:[inc([get([v(database)]/count)])])])][pemit(%#, [u([v(database)]/fn`prompt, jobs)] You have reordered all the jobs!)]}, @pemit %#=[error()]

&CMD`URGENT Rockpath's Jobs System=$+job/urgency *=*:@break [u([v(database)]/bool`is-staff)]={@break [t([setr(j, [u([v(database)]/fn`get-job, %0)])])]={@skip/ifelse [t([lor([iter([get(%qj/tier)], [u([v(database)]/tier`##, %#)])])])]={@eval [u([v(database)]/fn`urgent,%qj,%1)]}, @pemit %#=[u([v(database)]/fn`prompt, Jobs)] You don't have permission to look at that job.}; @pemit %#=[u([v(database)]/fn`prompt, Jobs)] You must specify a valid Job.};@pemit %#={[printf($^78:[ansi(hb, -=)]:s, < [ansi(hw, End Jobs)] >)]}};@pemit %#=[error()]

@@ SR4: save category+requester before fn call (fn destroys job); trigger hook after
&CMD`COMPLETE Rockpath's Jobs System=$+job/complete *=*:@break [u([v(database)]/bool`is-staff)]={@break [t([setr(j, [u([v(database)]/fn`get-job, %0)])])]={@skip/ifelse [t([lor([iter([get(%qj/tier)], [u([v(database)]/tier`##, %#)])])])]={@eval [setq(c,[get(%qj/category)])][setq(r,[get(%qj/requester)])][u([v(database)]/fn`complete-job, %qj, %1)]; @trigger me/HOOK_ON_COMPLETE=%qc,%qr,%1}, @pemit %#=[u([v(database)]/fn`prompt, jobs)] You don't have permission to look at that job.}; @pemit %#=[u([v(database)]/fn`prompt, jobs)] You must specify a valid Job.}; @pemit %#=[error()]

